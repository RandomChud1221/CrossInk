@@ -22,6 +22,7 @@
 
 ### Changed
 
+- User-facing book titles now use the book filename without its extension across Home, reader menus/status, reading stats, bookmarks, and clippings.
 - Reader font sizes now persist as actual point sizes, keeping the closest matching size when font families or installed files change.
 - SD-card fonts now include the built-in reader fallback stack for common symbols, emoji, and selected CJK glyphs while retaining Noto Sans fallback coverage.
 - Downloadable SD-card fonts are now rendered with the same darker anti-aliasing as the built-in reading fonts.
diff --git a/include/BookDisplayTitle.h b/include/BookDisplayTitle.h
new file mode 100644
index 0000000..262d493
--- /dev/null
+++ b/include/BookDisplayTitle.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <string>
+
+namespace BookDisplayTitle {
+
+// User-facing book titles follow the SD-card filename, without its extension.
+// Metadata remains available to parsers/stores for interoperability and migration.
+inline std::string fromPath(const std::string& path) {
+  const size_t slash = path.find_last_of('/');
+  const size_t start = slash == std::string::npos ? 0 : slash + 1;
+  const size_t dot = path.find_last_of('.');
+  const size_t end = dot == std::string::npos || dot <= start ? path.size() : dot;
+  return path.substr(start, end - start);
+}
+
+}  // namespace BookDisplayTitle
